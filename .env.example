# ImageKit Configuration
# Sign up at https://imagekit.io/
IMAGEKIT_PUBLIC_KEY=your_public_key_here
IMAGEKIT_PRIVATE_KEY=your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# AI Providers (Multiple providers for reliability + cost optimization)

# OpenRouter (Primary - Free & Paid models)
# Sign up at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_FREE_MODEL=google/gemma-2-9b-it:free
OPENROUTER_PAID_MODEL=anthropic/claude-3.5-sonnet

# Groq (Secondary provider - Ultra-fast inference)
# Sign up at https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/vettcode
# Or MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/vettcode

# NextAuth.js Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here_min_32_chars

# Google OAuth (Get from https://console.cloud.google.com/)
# Note: Using Web Authentication API (client secret not required)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email (Gmail SMTP for verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=VettCode <noreply@vettcode.dev>

# Application Settings
JWT_SECRET=your_random_secret_here_min_32_chars
ACCESS_TOKEN_SECRET=your_access_token_secret_here_min_64_chars

# Redis (for caching & rate limiting - optional but recommended)
REDIS_URL=redis://localhost:6379

# Subscription Limits (can override in database)
FREE_DAILY_AI_LIMIT=5
PRO_MONTHLY_AI_LIMIT=150
PRO_PLUS_MONTHLY_AI_LIMIT=500
